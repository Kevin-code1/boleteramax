# BoletaMax — Variables de entorno
# Copia este archivo como .env y reemplaza los valores

OPENAI_API_KEY=your-openai-api-key-here
PORT=3000

# PostgreSQL local o administrado
# Ejemplo local: postgres://postgres:postgres@localhost:5432/boletamax
DATABASE_URL=postgres://postgres:postgres@localhost:5432/boletamax

# Storage de lectura de boletos: postgres-primary, json, postgres o dual-read
TICKETS_STORAGE=postgres-primary

# Escritura de compras: postgres-primary, json o dual-write
TICKETS_WRITE_MODE=postgres-primary

# Rollback temporal a JSON:
# TICKETS_STORAGE=json
# TICKETS_WRITE_MODE=json

# (Opcional) Secreto para firmar cotizaciones de checkout
# CHECKOUT_SIGNING_SECRET=un-secreto-largo-y-aleatorio

# (Opcional) Cloudflare Turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# (Opcional) Clave de autenticación para staff de validación de boletos
# ADMIN_API_KEY=una-clave-segura-para-staff

# (Opcional) URL pública del servidor
# PUBLIC_BASE_URL=https://tu-dominio.com

# Base pública usada para construir los enlaces de verificación de correo.
# Si se omite, se usa PUBLIC_BASE_URL o el host de la petición.
# APP_BASE_URL=https://tu-dominio.com

# Correo (verificación de cuenta).
# En desarrollo, sin SMTP_HOST el enlace se imprime en consola.
# En producción SMTP_HOST es OBLIGATORIO (el servidor no arranca sin él).
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=tu-usuario-smtp
# SMTP_PASS=tu-password-smtp
# SMTP_FROM=BoletaMax <no-reply@tu-dominio.com>
