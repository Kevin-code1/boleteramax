{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "boletamax-dev (Express + watch)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "boletamax-start (Express)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.mjs"],
      "port": 3000
    },
    {
      "name": "boletamax-static (PowerShell)",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-ExecutionPolicy", "Bypass", "-File", "bm_server.ps1"],
      "port": 7734
    }
  ]
}
